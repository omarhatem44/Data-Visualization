# Shared matplotlib / seaborn style for the portfolio

figure.figsize       : 10, 6
figure.facecolor     : white
savefig.facecolor    : white

font.family          : sans-serif
font.sans-serif      : Fira Sans, Inter, Arial, DejaVu Sans
font.size            : 11
text.color           : 1F2933

axes.facecolor       : white
axes.edgecolor       : C3CAD3
axes.linewidth       : 0.8
axes.spines.top      : False
axes.spines.right    : False
axes.grid            : True
axes.grid.axis       : y
axes.axisbelow       : True
axes.labelcolor      : 5F6B78
axes.labelsize       : 11
axes.labelpad        : 8
axes.titlesize       : 12.5
axes.titleweight     : bold
axes.titlelocation   : left
axes.titlecolor      : 1F2933
axes.titlepad        : 10
axes.prop_cycle      : cycler('color', ['0072B2', 'E69F00', '009E73', 'D55E00', 'CC79A7', '56B4E9'])

grid.color           : E8EBEF
grid.linewidth       : 0.9

xtick.color          : 5F6B78
ytick.color          : 5F6B78
xtick.labelsize      : 10
ytick.labelsize      : 10
xtick.major.size     : 0
ytick.major.size     : 0
xtick.minor.size     : 0
ytick.minor.size     : 0
xtick.major.pad      : 6
ytick.major.pad      : 6

legend.frameon       : False
legend.fontsize      : 10

lines.linewidth      : 2
lines.solid_capstyle : round
